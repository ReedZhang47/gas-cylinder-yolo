# 大文件 / 可再生文件：禁止入库（本文件每行一个纯模式，勿加行内注释，gitignore 不支持行内 # 注释）
.venv/
runs/
weights/
_trash/
/_archive/
.tmp/
annotator_demo_data/

# 本地历史归档；正式方法、结果与正文资源放在归档目录之外
**/archive/
/scripts/legacy/

# 依赖、可再生预览与本地缓存
node_modules/
.pytest_cache/
.ruff_cache/
.mypy_cache/
/paper/figures/ppt_editable/previews/

# 私有 prompt 台账
Prompt.md

# 大二进制（论文 PDF / 文献库 PDF 等本地缓存）
*.pdf
# 例外：正文当前引用的 PDF 是必要资源，随仓库保存
!/paper/figures/manuscript/*.pdf

# 日志
*.log

# GUI 验证截图（过程产物）
shot*.png

# LaTeX 编译中间产物（.log / .pdf 已被上面的通用规则覆盖）
*.aux
*.out
*.spl
*.synctex.gz
*.bbl
*.blg
*.fls
*.fdb_latexmk

# 编辑器 / 系统
.vscode/
.idea/
__pycache__/
*.pyc
Thumbs.db
Desktop.ini

# literature PDFs are not tracked (moved here 2026-09-18)
paper/reference/

# agent 运行日志与一次性测量产物
logs/
/experiments/v5_d/pipeline.lock
